NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-value

KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=Car_ServiceCenter
KEYCLOAK_ISSUER=http://localhost:8080/realms/Car_ServiceCenter
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8080/realms/Car_ServiceCenter

# The sample secrets below are for localhost only. Replace them for any shared deployment.
KEYCLOAK_CLIENT_ID=iam-frontend
KEYCLOAK_CLIENT_SECRET=iam-frontend-client-secret

KEYCLOAK_ADMIN_CLIENT_ID=iam-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=iam-admin-api-client-secret

KEYCLOAK_PASSWORD_CHECK_CLIENT_ID=iam-password-check
KEYCLOAK_PASSWORD_CHECK_CLIENT_SECRET=iam-password-check-client-secret

# Google OAuth / SSO
# Authorized redirect URI in Google Cloud:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Used only by `npm.cmd run provision:car-service` to create the realm.
# These are your Keycloak master/admin-console credentials, not app credentials.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-local-keycloak-admin-password
# Required when provisioning a non-local Keycloak target. Localhost uses a temporary sample default.
CAR_SERVICE_DEFAULT_PASSWORD=

# This no-SPI build does not use Keycloak execute-actions-email or Keycloak required-action pages.
# Email verification and app-managed MFA are handled by Next.js UI/routes.

# App-managed MFA / custom email verification
# Required in production. Local development falls back to NEXTAUTH_SECRET.
APP_MFA_ENCRYPTION_KEY=
APP_MFA_ISSUER=IAM Platform
APP_MFA_SETUP_MINUTES=10
EMAIL_VERIFICATION_TOKEN_MINUTES=10
APP_EMAIL_OTP_PEPPER=replace-with-a-long-random-value
APP_EMAIL_EXPOSE_LOCAL_OTP=false

# Optional app SMTP for Next.js email verification OTP.
# Set APP_EMAIL_EXPOSE_LOCAL_OTP=true only for local development/testing; never use it in shared or production environments.
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_SECURE=false
APP_SMTP_USER=
APP_SMTP_PASS=
APP_SMTP_TIMEOUT_MS=10000
APP_SMTP_FROM=

# Redis-backed API rate limiting
REDIS_URL=redis://127.0.0.1:6379
REDIS_RATE_LIMIT_PREFIX=iam:rate
API_RATE_LIMIT_ATTEMPTS=100
API_RATE_LIMIT_WINDOW_SECONDS=60
# Defaults to fail-open with an in-memory fallback if Redis is down.
REDIS_RATE_LIMIT_FAIL_CLOSED=false
# Production behind a trusted proxy must set this true for anonymous request limits.
# The proxy must overwrite forwarding headers; otherwise clients can spoof their IP.
TRUST_PROXY=false
# Set true only for local debugging when you need to bypass API limits.
RATE_LIMIT_DISABLED=false

# Local OpenTelemetry collector (Grafana LGTM)
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
